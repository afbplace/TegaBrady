# Copy to clipper/.env (git-ignored). Keys stay server-side; the browser never sees them.
# Leave a provider blank to keep it in clearly labelled MOCK mode.

# OpusClip API (Pro / Max / Business plan; key from the OpusClip dashboard)
OPUSCLIP_API_KEY=
OPUSCLIP_ORG_ID=

# Upload-Post (publishes to Instagram Reels, TikTok, YouTube Shorts)
UPLOAD_POST_API_KEY=
# The Upload-Post profile name your social accounts are linked to
UPLOAD_POST_USER=

# Optional
# CLIPPER_PORT=5050
# CLIPPER_DATA_DIR=./data
# CLIPPER_MAX_UPLOAD_MB=2048
